{
  "repo": "ember-svc-notify-forge",
  "language": "Kotlin",
  "category": "Backend services",
  "goal": "Design a Kotlin verification harness for notify systems, covering security rule linting, safe and unsafe fixtures, and failure-oriented tests.",
  "review_model": {
    "terms": [
      "queue pressure",
      "retry load",
      "worker slack",
      "session drift"
    ],
    "lanes": [
      "ship",
      "watch",
      "hold"
    ],
    "score": "signal * 2 + slack + confidence - drag * 3",
    "purpose": "surface the domain-specific cases that need the most careful review"
  },
